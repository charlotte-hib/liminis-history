# Grafana settings the server's grafana.env may override: Compose reads grafana.env after this file,
# and a variable under `environment:` would win over both.
# The address Grafana is opened at, for its links and redirects. Locally and through an SSH tunnel it is
# localhost:3001; a server that serves Grafana under another address sets GF_SERVER_ROOT_URL in grafana.env.
GF_SERVER_ROOT_URL=http://localhost:3001/
# Where alerts are emailed (provisioning/alerting/traffic.yaml). A placeholder that never delivers, so Grafana starts
# without it; grafana.env sets the real address, with the SMTP server: GF_SMTP_ENABLED=true, GF_SMTP_HOST (host:port),
# GF_SMTP_USER, GF_SMTP_PASSWORD and GF_SMTP_FROM_ADDRESS.
ALERT_EMAIL=alerts@example.invalid
GF_SMTP_FROM_NAME=Liminis
