# End-to-end smoke tests for the public API, against the release in sample/.
# Start the backend with Wikipedia enrichment off (--app.wikipedia.enrich=false), then run a request
# from IntelliJ with the "local" environment, or all of them with the HTTP Client CLI:
#   ijhttp --env-file http/http-client.env.json --env local http/api.http

### Moments: the published moments, with who governed and the length of their story
GET {{baseUrl}}/api/moments
Accept: application/json

> {%
    client.test("200 with JSON", () => {
        client.assert(response.status === 200, `status ${response.status}`);
        client.assert(response.contentType.mimeType === "application/json", `content type ${response.contentType.mimeType}`);
    });
    client.test("Paris in the 1870s, under the Third Republic, with a 7-card story", () => {
        const paris = response.body.find(m => m.id === "paris-1870s");
        client.assert(paris !== undefined, "paris-1870s is missing");
        client.assert(paris.governedBy === "Third Republic", `governedBy ${paris.governedBy}`);
        client.assert(paris.storyCards === 7, `storyCards ${paris.storyCards}`);
    });
%}

### Story: a moment's cards in order, then its doors
GET {{baseUrl}}/api/moments/paris-1870s/story
Accept: application/json

> {%
    client.test("200 with JSON", () => {
        client.assert(response.status === 200, `status ${response.status}`);
        client.assert(response.contentType.mimeType === "application/json", `content type ${response.contentType.mimeType}`);
    });
    client.test("Cards in story order, then three doors", () => {
        const types = response.body.cards.map(c => c.type).join(",");
        client.assert(types === "SCENE,SCENE,PERSON,PERSON,LIFE,EVENT,EVENT", `card types ${types}`);
        client.assert(response.body.cards[2].person.slug === "georges-clemenceau", "the third card is not Clemenceau");
        client.assert(response.body.doors.length === 3, `${response.body.doors.length} doors`);
    });
%}

### A moment's people in a year, in draws of 24: the second shows others
GET {{baseUrl}}/api/moments/paris-1870s/people?year=1875&draw=1
Accept: application/json

> {%
    client.test("200 with JSON", () => {
        client.assert(response.status === 200, `status ${response.status}`);
        client.assert(response.contentType.mimeType === "application/json", `content type ${response.contentType.mimeType}`);
    });
    client.test("Draw 1 of several, 24 people at most, with their occupations", () => {
        client.assert(response.body.year === 1875, `year ${response.body.year}`);
        client.assert(response.body.draw === 1, `draw ${response.body.draw}`);
        client.assert(response.body.draws > 1, `${response.body.draws} draws`);
        client.assert(response.body.people.length > 0 && response.body.people.length <= 24, `${response.body.people.length} people`);
        client.assert(Array.isArray(response.body.people[0].occupations), "no occupations list");
    });
%}

### Person in a year: Zola in 1875, in the world around him
GET {{baseUrl}}/api/people/emile-zola?year=1875
Accept: application/json

> {%
    client.test("200 with JSON", () => {
        client.assert(response.status === 200, `status ${response.status}`);
        client.assert(response.contentType.mimeType === "application/json", `content type ${response.contentType.mimeType}`);
    });
    client.test("Aged 35, in Paris in the 1870s", () => {
        client.assert(response.body.person.name === "Émile Zola", `name ${response.body.person.name}`);
        client.assert(response.body.year === 1875, `year ${response.body.year}`);
        client.assert(response.body.age === 35, `age ${response.body.age}`);
        client.assert(response.body.worldMoment.id === "paris-1870s", `worldMoment ${response.body.worldMoment.id}`);
    });
%}

### Search: people and moments, ignoring accents
GET {{baseUrl}}/api/search?q=zola
Accept: application/json

> {%
    client.test("200 with JSON", () => {
        client.assert(response.status === 200, `status ${response.status}`);
        client.assert(response.contentType.mimeType === "application/json", `content type ${response.contentType.mimeType}`);
    });
    client.test("Émile Zola comes first", () => {
        const first = response.body.people[0];
        client.assert(first !== undefined && first.slug === "emile-zola", `first person ${first && first.slug}`);
    });
%}

### Unknown moment: 404
GET {{baseUrl}}/api/moments/atlantis
Accept: application/json

> {%
    client.test("404 as Problem Details", () => {
        client.assert(response.status === 404, `status ${response.status}`);
        client.assert(response.contentType.mimeType === "application/problem+json", `content type ${response.contentType.mimeType}`);
        client.assert(response.body.status === 404, `body status ${response.body.status}`);
        client.assert(response.body.detail === "Unknown moment: atlantis", `detail ${response.body.detail}`);
    });
%}

### Visitor event: a story started, sent like the frontend's beacon (text/plain)
POST {{baseUrl}}/api/events
Content-Type: text/plain;charset=UTF-8

{"name":"story_started","moment":"paris-1870s"}

> {%
    client.test("204, counted", () => {
        client.assert(response.status === 204, `status ${response.status}`);
    });
%}

### Visitor event outside the vocabularies: a moment that does not exist
POST {{baseUrl}}/api/events
Content-Type: application/json

{"name":"story_started","moment":"atlantis"}

> {%
    client.test("400, not counted", () => {
        client.assert(response.status === 400, `status ${response.status}`);
    });
%}
