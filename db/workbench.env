# The workbench database's settings (compose.workbench.yaml). On the curator's computer it is published on loopback
# only, so this password never protects anything reachable from elsewhere. On the server (compose.review.yaml),
# review-db.env (untracked) gives it a password of its own.
POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench
