# The database's settings, read by the db and backend services in docker-compose.yml. On the server, db.env
# (untracked, next to .env) comes after this file and overrides the password: deploy/deploy.sh creates it with a
# random one on its first run. Locally and in CI there is no db.env, and this password applies.
POSTGRES_DB=liminis
POSTGRES_USER=liminis
POSTGRES_PASSWORD=liminis
