#!/usr/bin/env bash
# wb: the workbench's command line. Starts runs on the workbench (./gradlew :workbench:bootRun, in backend/) and follows
# them, or shows what waits for review. Signs in to auth (./gradlew :auth:bootRun, in backend/) as the wb client, with
# the secret auth wrote on its first start.
set -euo pipefail

url="${WB_URL:-http://localhost:8090}"
auth_url="${WB_AUTH_URL:-http://localhost:9000}"
secret_file="${WB_SECRET_FILE:-$HOME/.config/liminis/wb-client-secret}"
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# Where the workbench writes the fetched dataset (app.dataset.export-dir, from backend/), and the private data
# repository's clone, next to this one, where its pin goes.
export_dir="${WB_EXPORT_DIR:-$repo/backend/dataset-export}"
data_repo="${WB_DATA_REPO:-$(dirname "$repo")/liminis-history-data}"
dataset_package=ghcr.io/charlotte-hib/liminis-history-dataset
# The data repository's CI pushes its release bundles with the same version.
oras_image=ghcr.io/oras-project/oras:v1.3.4@sha256:f7bc056d54d97baa399414ed5048ecc67c3371b750d4bbce1d871827a5758179

usage() {
  cat <<'EOF'
Usage: wb <command>

  import          fetch Wikidata's people, or resume the import that stopped (hours)
  map             map the last finished import to the dataset's rows
  export          export the dataset's rows to files, push them to a private package, and pin it in the data
                  repository's data/fetched.lock (needs Docker, and gh with write:packages)
  sample          write the public sample/'s slice of the last export into sample/dataset/: its people, and the
                  people most written about of its moments' places (no workbench needed)
  claims          propose the facts of the people of the release's moments for review
  occupations     propose a domain to choose for every occupation the dataset's people hold, the most held first,
                  then their classes
  draft <moment>  draft a moment's story with Claude, for review in curate (needs ANTHROPIC_API_KEY where the
                  workbench runs)
  runs [id]       the runs since the workbench started, or one of them
  queues          how many claims wait for review, by type and flag

A run is followed until it ends; Ctrl-C stops following, not the run.
EOF
}

access_token=""
signed_in_at=0

# Gets an access token of wb's own from auth, valid 10 minutes, and again once it is 5 minutes old: a run is followed
# for hours. Called before api, never inside $(...), whose subshell would forget the token. The secret and the token
# reach curl on its standard input (printf is a builtin), never in its arguments, which any user's ps shows.
sign_in() {
  [[ -n "$access_token" && $((SECONDS - signed_in_at)) -lt 300 ]] && return
  [[ -r "$secret_file" ]] || { echo "wb: no secret in $secret_file. Has auth started once?" >&2; exit 1; }
  local response
  response="$(printf 'user = "wb:%s"\n' "$(<"$secret_file")" | curl --config - --silent --show-error \
    --write-out '\n%{http_code}' --data grant_type=client_credentials --data-urlencode 'scope=curation:read runs' \
    "$auth_url/oauth2/token")" ||
    { echo "wb: auth does not answer at $auth_url" >&2; exit 1; }
  [[ "${response##*$'\n'}" == 200 ]] || { echo "wb: auth refused to sign wb in: ${response%$'\n'*}" >&2; exit 1; }
  access_token="$(json "${response%$'\n'*}" "d['access_token']")"
  signed_in_at=$SECONDS
}

api() {
  local method="$1" path="$2" body="${3:-}"
  local args=(--config - --silent --show-error --write-out '\n%{http_code}' --request "$method")
  [[ -n "$body" ]] && args+=(--header 'Content-Type: application/json' --data "$body")
  local response
  response="$(printf 'header = "Authorization: Bearer %s"\n' "$access_token" | curl "${args[@]}" "$url$path")" ||
    { echo "wb: the workbench does not answer at $url" >&2; exit 1; }
  local status="${response##*$'\n'}"
  response="${response%$'\n'*}"
  if [[ "$status" -ge 400 ]]; then
    echo "wb: $status $(json "$response" "d.get('detail') or d.get('title') or ''" 2>/dev/null || true)" >&2
    exit 1
  fi
  printf '%s' "$response"
}

# Evaluates a Python expression on the JSON document $1, bound to d.
json() {
  python3 -I -c 'import json, sys; d = json.loads(sys.argv[1]); print(eval(sys.argv[2]))' "$1" "$2"
}

show_run() {
  json "$1" "f\"Run {d['id']}: {d['kind']}{' ' + d['moment'] if d.get('moment') else ''}, {d['status']}{': ' + d['result'] if d.get('result') else ''}\""
}

start() {
  local run id
  sign_in
  run="$(api POST /api/runs "$1")"
  show_run "$run"
  id="$(json "$run" "d['id']")"
  while [[ "$(json "$run" "d['status']")" == RUNNING ]]; do
    sleep 2
    sign_in
    run="$(api GET "/api/runs/$id")"
  done
  show_run "$run"
  [[ "$(json "$run" "d['status']")" == SUCCEEDED ]]
}

# Exports the dataset, pushes it with ORAS (in Docker, with gh's token) and writes its digest to data/fetched.lock.
# The same rows make the same files and the same digest: pushing them again adds nothing.
export_dataset() {
  [[ -d "$data_repo/data" ]] || { echo "wb: no data repository at $data_repo (WB_DATA_REPO)" >&2; exit 1; }
  start '{"kind": "DATASET_EXPORT"}'
  local manifest tag digest
  manifest="$(<"$export_dir/manifest.json")"
  tag="$(json "$manifest" "f\"import-{d['import']['run']}-{d['import']['finishedAt'][:10].replace('-', '')}\"")"
  echo "Pushing $dataset_package:$tag"
  # Created when the import finished, not now, so that the same files make the same manifest. The files and their media
  # types are DatasetFile's (backend/core).
  if ! digest="$(gh auth token | docker run --rm --interactive --volume "$export_dir:/workspace:ro" "$oras_image" push \
    --username "$(gh api user --jq .login)" --password-stdin \
    --artifact-type application/vnd.liminis.dataset.v1 \
    --annotation "org.opencontainers.image.created=$(json "$manifest" "d['import']['finishedAt']")" \
    --annotation "org.opencontainers.image.source=https://github.com/charlotte-hib/liminis-history-data" \
    --format go-template='{{.digest}}' \
    "$dataset_package:$tag" \
    manifest.json:application/vnd.liminis.dataset.manifest.v1+json \
    people.jsonl.gz:application/vnd.liminis.dataset.people.v1.jsonl+gzip \
    articles.jsonl.gz:application/vnd.liminis.dataset.articles.v1.jsonl+gzip \
    places.jsonl.gz:application/vnd.liminis.dataset.places.v1.jsonl+gzip \
    occupations.jsonl.gz:application/vnd.liminis.dataset.occupations.v1.jsonl+gzip)"; then
    echo "wb: the push failed. Is Docker running, and may gh push packages? (gh auth refresh -s write:packages)" >&2
    exit 1
  fi
  {
    echo "# The fetched dataset the release is built on: Wikidata's and Wikipedia's facts, with no decision applied, in a"
    echo "# private package. Written by the code repository's wb export; change it in a pull request of its own."
    echo "DATASET=$dataset_package@$digest"
    json "$manifest" "'\\n'.join([f\"IMPORT_FINISHED={d['import']['finishedAt']}\"] + [f'{k.upper()}={v}' for k, v in d['counts'].items()])"
  } > "$data_repo/data/fetched.lock"
  echo "Pinned $dataset_package@$digest in $data_repo/data/fetched.lock: commit it on a branch there and open a pull request."
}

case "${1:-}" in
  import) start '{"kind": "WIKIDATA_IMPORT"}' ;;
  map) start '{"kind": "DATASET_MAPPING"}' ;;
  export) export_dataset ;;
  sample) python3 -I "$repo/backend/workbench/sample_dataset.py" "$export_dir" "$repo/sample" ;;
  claims) start '{"kind": "PERSON_FACTS_CLAIMS"}' ;;
  occupations) start '{"kind": "OCCUPATION_CLAIMS"}' ;;
  draft)
    [[ -n "${2:-}" ]] || { usage >&2; exit 2; }
    start "{\"kind\": \"STORY_DRAFT\", \"moment\": \"$2\"}"
    ;;
  runs)
    sign_in
    if [[ -n "${2:-}" ]]; then
      show_run "$(api GET "/api/runs/$2")"
    else
      json "$(api GET /api/runs)" "'\n'.join(f\"{r['id']}  {r['kind']}  {r['status']}  {r.get('result') or ''}\" for r in d) or 'No run yet'"
    fi
    ;;
  queues)
    sign_in
    json "$(api GET /api/queues)" "'\n'.join(f\"{q['type']}: {q['candidates']} waiting, {q['needsWork']} kept for later\" + ''.join(f\"\n  {f}: {n}\" for f, n in q['flags'].items()) for q in d) or 'Nothing waits'"
    ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
